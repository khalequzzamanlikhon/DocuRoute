# ── PRIMARY LLM: Groq ────────────────────────────────────────────────────────
# Free key (no card needed): https://console.groq.com → API Keys → Create
# Free tier: 14,400 requests/day
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── SECONDARY LLM: OpenRouter ────────────────────────────────────────────────
# Get key at https://openrouter.ai/keys
# Auto-fallback on Groq rate-limit before trying Gemini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default, uncomment to override

# ── TERTIARY FALLBACK LLM: Gemini ─────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
# Used automatically when both Groq and OpenRouter rate-limit.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Qdrant runs embedded (on-disk) by default, so no host/port needed.
# Set these only if you run a real Qdrant server (docker-compose.yml provides one).
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_MODE=local   # "local" = embedded on-disk, "server" = use host/port above

# DuckDB file backing the structured tables extracted from your documents
DUCKDB_PATH=./data/processed/tables.duckdb

# Paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
QDRANT_STORAGE_PATH=./data/processed/qdrant_storage

# Retrieval tuning
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FUSED=10
TOP_K_FINAL=5
FAITHFULNESS_THRESHOLD=0.7
